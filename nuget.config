<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <!-- Allow NuGet to download missing packages -->
    <add key="enabled" value="True" />
    <!-- Automatically check for missing packages during build in Visual Studio -->
    <add key="automatic" value="True" />
  </packageRestore>
  <packageSources>
    <clear />
    <!--
      DO NOT ADD ANOTHER PACKAGE SOURCES. WE MUST HAVE A SINGLE PACKAGE SOURCE - AzureDACS.
      See https://learn.microsoft.com/nuget/consume-packages/consuming-packages-authenticated-feeds for details.
      If we need to consume packages from another feed, we can either add that feed as an upstream of AzureDACS:
      internal-reference-removed
      DO NOT ADD ANOTHER PACKAGE SOURCES. WE MUST HAVE A SINGLE PACKAGE SOURCE - AzureDACS.
      or we can push those packages to AzureDACS feed. We have pushnuget macro to do this.
    -->
    <add key="AzureDACS" value="internal-reference-removed" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>