# Minikube Configuration
CLUSTER_NAME=minikube
NAMESPACE=default
CACHE_SERVER_REPLICAS=3
CACHE_SERVER_IMAGE=cacheserver:local
CACHE_CLIENT_IMAGE=cacheclient:local
MINIKUBE_NODES=4
MINIKUBE_MEMORY=4096
MINIKUBE_CPUS=4

# Performance Test Configuration
PERF_NUM_THREADS=1
PERF_DATA_SIZE_GIB=1
PERF_NUM_ITERATIONS=1

# Storage Intercept Configuration
# Path relative to scripts/k8s/ directory
STORAGE_CONFIG_PATH=config/storageIntercept.config