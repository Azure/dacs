link_directories("$ENV{NCCL_ROOT}/lib64")
link_directories("$ENV{NCCL_ROOT}/lib")
link_directories("$ENV{CUDNN_ROOT}/lib64")
link_directories("$ENV{CUDNN_ROOT}/lib")
