<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <LinuxCMakeProjBuildDependsOnTargets Condition=" '$(OS)' != 'Windows_NT' ">
      CreateCMakeOutputFolders;
      GetNativeBuildParameters;
      LinuxCMakeBuild;
    </LinuxCMakeProjBuildDependsOnTargets>
    <LinuxCMakeProjBuildDependsOnTargets Condition=" '$(CDP_BUILD_TYPE)' == '' and '$(OS)' == 'Windows_NT' ">
      CreateCMakeOutputFolders;
      GetBuildMetadata;
      GetNativeBuildContainerImageParameters;
      EnsureNativeBuildContainerImageAvailable;
      WindowsCMakeBuild;
    </LinuxCMakeProjBuildDependsOnTargets>
    <LinuxCMakeProjNativeUnitTestDependsOnTargets Condition=" '$(OS)' == 'Windows_NT' ">
      Build;
      WindowsCTestBuild;
    </LinuxCMakeProjNativeUnitTestDependsOnTargets>
    <!-- For each DACS repo on the machine, we will create a docker volume.
         If repo root is d:\repos\DACS.2, volume name will be dacs_d_repos_dacs.2
    -->
    <NativeBuildDockerVolume Condition=" '$(OS)' == 'Windows_NT' ">dacs_$(RepositoryRootPath.Replace(':', '').Replace('\', '_').Replace(' ', '_').ToLowerInvariant())</NativeBuildDockerVolume>
    <NativeBuildDockerVolume Condition=" '$(OS)' == 'Windows_NT' ">$(NativeBuildDockerVolume.TrimEnd('_'))</NativeBuildDockerVolume>
    <LinuxCMakeProjPublishDependsOnTargets>
      Build;
    </LinuxCMakeProjPublishDependsOnTargets>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)UpdateMetadata\UpdateMetadataContent.targets" />

  <Target Name="GetNativeBuildParameters">
    <PropertyGroup>
      <NativeBuildWorkingDirectory>$(IntermediateOutputPath)</NativeBuildWorkingDirectory>
      <NativeBuildCommand>$(RepositoryRootPath)build/LinuxCMakeProj.Build.sh</NativeBuildCommand>
    </PropertyGroup>
  </Target>

  <Target Name="GetNativeBuildContainerImageParameters">

    <FindInList CaseSensitive="false" List="@(BuildMetadata)" ItemSpecToFind="native-build-imagelabel" >
      <Output TaskParameter="ItemFound" ItemName="NativeBuildImageLabel"/>
    </FindInList>

    <FindInList CaseSensitive="false" List="@(BuildMetadata)" ItemSpecToFind="native-build-imagename" >
      <Output TaskParameter="ItemFound" ItemName="NativeBuildImageName"/>
    </FindInList>

    <Error Text="Build Metadata Parameter 'native-build-imagelabel' not defined" Condition=" '@(NativeBuildImageLabel)' == '' "/>
    <Error Text="Build Metadata Parameter 'native-build-imagename' not defined" Condition=" '@(NativeBuildImageName)' == '' "/>

    <PropertyGroup>
      <NativeBuildContainerImageName>%(NativeBuildImageName.Value)</NativeBuildContainerImageName>
      <NativeBuildContainerImageLabel>%(NativeBuildImageLabel.Value)</NativeBuildContainerImageLabel>
      <NativeBuildContainerImage>$(ContainerImageRepository).azurecr.io/$(NativeBuildContainerImageName):$(NativeBuildContainerImageLabel)</NativeBuildContainerImage>
      <RepositoryRootPathInContainer>/repo/</RepositoryRootPathInContainer>
      <BuildObjectRootPathInContainer>$([System.String]::Copy('$(BuildObjectRoot)').Replace('$(RepositoryRootPath)','$(RepositoryRootPathInContainer)'))</BuildObjectRootPathInContainer>
      <BuildBinaryRootPathInContainer>$([System.String]::Copy('$(BuildBinaryRoot)').Replace('$(RepositoryRootPath)','$(RepositoryRootPathInContainer)'))</BuildBinaryRootPathInContainer>
      <ContainerEnvFile>$(IntermediateOutputPath)envlist.txt</ContainerEnvFile>
      <RepositoryRootVolumeMount>-v $(RepositoryRootPath):$(RepositoryRootPathInContainer)</RepositoryRootVolumeMount>
      <LinuxMSBuildProjectRelativePath>$([System.String]::Copy('$(MSBuildProjectRelativePath)').Replace('\','/'))</LinuxMSBuildProjectRelativePath>
      <NativeBuildContainerWorkingDirectory>$(BuildObjectRootPathInContainer)/$(CMAKE_BUILD_CONFIGURATION)/$(LinuxMSBuildProjectRelativePath)</NativeBuildContainerWorkingDirectory>
      <NativeBuildContainerBinaryDirectory>$(BuildBinaryRootPathInContainer)/$(CMAKE_BUILD_CONFIGURATION)/$(LinuxMSBuildProjectRelativePath)</NativeBuildContainerBinaryDirectory>
      <NativeBuildContainerCommand>$(RepositoryRootPathInContainer)build/LinuxCMakeProj.Build.sh</NativeBuildContainerCommand>
      <NativeUnitTestContainerCommand>$(RepositoryRootPathInContainer)build/LinuxCMakeProj.Test.sh</NativeUnitTestContainerCommand>
    </PropertyGroup>

    <ItemGroup>
      <LinuxCMakeContainerEnvironmentProperties Include="@(LinuxCMakeEnvironmentProperties->Replace('$(RepositoryRootPath)', '$(RepositoryRootPathInContainer)')->Replace('\','/'))"/>
    </ItemGroup>

    <Delete Files="$(ContainerEnvFile)" />
    <WriteLinesToFile File="$(ContainerEnvFile)" Lines="@(LinuxCMakeContainerEnvironmentProperties)" Encoding="Ascii" />
  </Target>

  <Target Name="LinuxCMakeBuild">
    <!-- Perform FAST_NATIVE_BUILD on Linux build VMs to make sure that FAST_NATIVE_BUILD is not broken -->
    <PropertyGroup>
      <FAST_NATIVE_BUILD Condition=" '$(FAST_NATIVE_BUILD)' != 'false' and '$(CDP_BUILD_TYPE)' != '' ">true</FAST_NATIVE_BUILD>
    </PropertyGroup>
    <Exec WorkingDirectory="$(NativeBuildWorkingDirectory)" Command="$(NativeBuildCommand)" IgnoreExitCode="false" ConsoleToMsBuild="true" EnvironmentVariables="@(LinuxCMakeEnvironmentProperties);FAST_NATIVE_BUILD=$(FAST_NATIVE_BUILD)"/>
  </Target>

  <Target Name="LinuxCTestBuild">
    <Exec WorkingDirectory="$(NativeBuildWorkingDirectory)" Command="$(NativeUnitTestContainerCommand)" IgnoreExitCode="false" ConsoleToMsBuild="true" EnvironmentVariables="@(LinuxCMakeEnvironmentProperties)"/>
  </Target>

  <Target Name="CreateCMakeOutputFolders">
    <MakeDir Directories="$(OutputPath);$(IntermediateOutputPath)" />
  </Target>
  <Target Name="EnsureNativeBuildContainerImageAvailable" >
    <Exec Command="$(PowershellCommand) -noprofile $(MSBuildThisFileDirectory)/Ensure-DockerImageAvailable.ps1 $(NativeBuildContainerImage)" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="WindowsCMakeBuild" Inputs="@(NativeInputFiles)" Outputs="$(IntermediateOutputPath)Nativebuild.done" >
    <PropertyGroup>
      <FAST_NATIVE_BUILD Condition=" '$(FAST_NATIVE_BUILD)' != 'false' ">true</FAST_NATIVE_BUILD>
      <DockerBuildCommand>docker run -i --rm --env-file $(ContainerEnvFile) --env NATIVE_BUILD_JOBS $(RepositoryRootVolumeMount) -w $(NativeBuildContainerWorkingDirectory) --cap-add=SYS_TIME</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) -v $(NativeBuildDockerVolume):/tmp/repo</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) --env FAST_NATIVE_BUILD=$(FAST_NATIVE_BUILD)</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) $(NativeBuildContainerImage) $(NativeBuildContainerCommand)</DockerBuildCommand>
    </PropertyGroup>
    <Exec Command="docker volume create $(NativeBuildDockerVolume)" StandardOutputImportance="low" />
    <Message Importance="high" text="Executing $(DockerBuildCommand)" />
    <Exec Command="$(DockerBuildCommand)" IgnoreExitCode="false" />
    <Touch Files="$(IntermediateOutputPath)Nativebuild.done" AlwaysCreate="true" />
  </Target>

  <Target Name="WindowsCTestBuild">
    <PropertyGroup>
      <DockerBuildCommand>docker run -i --rm --env-file $(ContainerEnvFile) --env NATIVE_BUILD_JOBS $(RepositoryRootVolumeMount) -w $(NativeBuildContainerWorkingDirectory) --cap-add=SYS_TIME</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) -v $(NativeBuildDockerVolume):/tmp/repo</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) -w $(NativeBuildContainerBinaryDirectory)</DockerBuildCommand>
      <DockerBuildCommand>$(DockerBuildCommand) $(NativeBuildContainerImage) $(NativeUnitTestContainerCommand)</DockerBuildCommand>
  </PropertyGroup>
    <Message Importance="high" text="Executing $(DockerBuildCommand)" />
    <Exec Command="$(DockerBuildCommand)" IgnoreExitCode="false" />
  </Target>

  <Target Name="Build" DependsOnTargets="$(LinuxCMakeProjBuildDependsOnTargets)" />
  <Target Name="LinuxCMakeProjPublish" DependsOnTargets="$(LinuxCMakeProjPublishDependsOnTargets)" />
  <Target Name="NativeUnitTest" DependsOnTargets="$(LinuxCMakeProjNativeUnitTestDependsOnTargets)" />

  <Target Name="Clean" >
    <ItemGroup>
      <_FilesToDelete Include="$(IntermediateOutputPath)**/*.*" />
      <!-- We need to preserve project.assets.json, otherwise dotnet build /t:rebuild from the root fails -->
      <_FilesToDelete Remove="$(IntermediateOutputPath)project.assets.json" />
      <_FilesToDelete Include="$(OutputPath)**/*.*"/>
    </ItemGroup>
    <Delete Files="@(_FilesToDelete)"/>
  </Target>
</Project>