<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepositoryRootPath>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..))</RepositoryRootPath>
    <RepositorySrcRootPath>$([MSBuild]::NormalizeDirectory($(RepositoryRootPath)src))</RepositorySrcRootPath>
    <SubsystemsPath>$([MSBuild]::NormalizeDirectory($(RepositorySrcRootPath)subsystems))</SubsystemsPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configuration Condition=" '$(Configuration)'=='' ">Debug</Configuration>
    <SkipNativeSubmoduleBuild Condition=" '$(SkipNativeSubmoduleBuild)'=='' ">false</SkipNativeSubmoduleBuild>
    <BuildWithDebugSymbols Condition=" '$(BuildWithDebugSymbols)'=='' ">false</BuildWithDebugSymbols>
    <MSBuildProjectRelativePath>$(MSBuildProjectDirectory.Replace($(RepositorySrcRootPath), ''))</MSBuildProjectRelativePath>
    <MSBuildProjectRelativePath Condition="$([System.IO.Path]::IsPathRooted($(MSBuildProjectRelativePath)))"></MSBuildProjectRelativePath>
    <BuildBinaryRoot Condition=" '$(BuildBinaryRoot)'=='' ">$(RepositoryRootPath)bin</BuildBinaryRoot>
    <BuildObjectRoot Condition=" '$(BuildObjectRoot)'=='' ">$(RepositoryRootPath)obj</BuildObjectRoot>
    <OutputPath>$(BuildBinaryRoot)\$(Configuration)\$(MSBuildProjectRelativePath)</OutputPath>
    <BaseIntermediateOutputPath>$(BuildObjectRoot)\$(Configuration)\$(MSBuildProjectRelativePath)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BuildObjectRoot)\$(Configuration)\$(MSBuildProjectRelativePath)</IntermediateOutputPath>
    <ContainerImageRepository Condition=" '$(ContainerImageRepository)'=='' ">dacs</ContainerImageRepository>
    <ContainerImageRepository Condition=" '$(CDP_BUILD_TYPE)'=='PullRequest' or '$(PARENT_CDP_BUILD_TYPE)'=='PullRequest' ">dacspullrequestacr</ContainerImageRepository>
    <ContainerImageRepository Condition=" '$(CDP_BUILD_TYPE)'=='Official' or '$(PARENT_CDP_BUILD_TYPE)'=='Official' ">dacsofficialacr</ContainerImageRepository>
    <UsingOfficialContainerImageRepository>false</UsingOfficialContainerImageRepository>
    <UsingOfficialContainerImageRepository Condition=" '$(ContainerImageRepository)'=='dacsofficialacr' ">true</UsingOfficialContainerImageRepository>
    <PublishDir>$(IntermediateOutputPath)\$(RuntimeIdentifier)\publish\</PublishDir>
    
    <!-- Centralized architecture detection and conversion -->
    <!-- Detect build architecture - prefer command line parameter, fallback to runtime detection -->
    <BuildArchitecture Condition="'$(BuildArchitecture)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLower())</BuildArchitecture>
    <!-- Convert .NET architecture names to our internal standard -->
    <BuildArchitecture Condition="'$(BuildArchitecture)' == 'x64'">x86_64</BuildArchitecture>
    
    <PowershellCoreCommand>pwsh</PowershellCoreCommand>
    <PowershellCommand Condition=" '$(OS)' != 'Windows_NT' ">pwsh</PowershellCommand>
    <PowershellCommand Condition=" '$(PowershellCommand)' == ''">powershell</PowershellCommand>
    <TargetFramework Condition=" '$(TargetFramework)' == '' ">netcoreapp3.1</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HighEntropyVA>true</HighEntropyVA>
    <ContainerImageRepository Condition=" '$(ContainerImageRepository)'=='' ">dacs</ContainerImageRepository>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(SlnGenSolutionFileFullPath)' == '' ">
    <SlnGenSolutionFileFullPath Condition=" '$(MSBuildProjectRelativePath)' != '' ">$(RepositoryRootPath)sln\$(MSBuildProjectRelativePath)\$(MSBuildProjectName).sln</SlnGenSolutionFileFullPath>
    <SlnGenSolutionFileFullPath Condition=" '$(MSBuildProjectRelativePath)' == '' ">$(RepositoryRootPath)sln\$(MSBuildProjectName).sln</SlnGenSolutionFileFullPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SlnGen">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
