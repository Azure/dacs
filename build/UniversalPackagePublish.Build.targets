<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)ResolveFrameworkReferences.targets" />

  <Target Name="PublishUniversalPackage">
    <Exec Condition="$(GIT_BRANCH)==''" Command="git rev-parse --symbolic-full-name --abbrev-ref HEAD" ConsoleToMsBuild="true" >
      <Output TaskParameter="ConsoleOutput" PropertyName="GIT_BRANCH" />
    </Exec>
    <Error Condition="'$(GIT_BRANCH)'=='main' And $(AZURE_DEVOPS_EXT_PAT)==''"
      Text="Build on main branch can only be executed in official pipeline." />
    <PropertyGroup>
      <PackageChannel Condition="'$(GIT_BRANCH)'=='main'">$(OfficialChannelName)</PackageChannel>
      <PackageChannel Condition="'$(PackageChannel)'==''">$(DevChannelName)</PackageChannel>
      <PackageName>$(PackageBaseName)-$(PackageChannel)</PackageName>
      <StoragePackageName>$(PackageBaseName)-storage-$(PackageChannel)</StoragePackageName>
      <StorageCacheClientPackageName>$(PackageBaseName)-storage-cache-client-$(PackageChannel)</StorageCacheClientPackageName>

      <CurrentDate>$([System.DateTime]::Now.ToString(Myddhhmm))</CurrentDate>
      <BranchHash Condition="'$(GIT_BRANCH)'=='main'">0</BranchHash>
      <BranchHash Condition="'$(BranchHash)'==''">$([System.Math]::Abs($(GIT_BRANCH.GetHashCode())).ToString().Substring(0, 5))</BranchHash>

      <PackageRevision Condition="'$(GIT_BRANCH)'=='main'">$(PACKAGE_REVISION)</PackageRevision>
      <PackageRevision Condition="'$(PackageRevision)'==''">0</PackageRevision>
      <PackageVersion>$(CurrentDate).$(BranchHash).$(PackageRevision)</PackageVersion>

      <PackagePublishDir>$(IntermediateOutputPath)$(ReferenceRuntimeIdentifier)\publish</PackagePublishDir>
      <!-- Use same directory structure for all architectures -->
      <StoragePackagePublishDir>$(IntermediateOutputPath)$(ReferenceRuntimeIdentifier)\publish-storage</StoragePackagePublishDir>
      <StorageCacheClientPackagePublishDir>$(IntermediateOutputPath)$(ReferenceRuntimeIdentifier)\publish-storage-cache-client</StorageCacheClientPackagePublishDir>
    </PropertyGroup>

    <Exec Command="az devops project list" IgnoreExitCode="true" ConsoleToMsBuild="true" IgnoreStandardErrorWarningFormat="true" >
      <Output TaskParameter="ConsoleOutput" PropertyName="AzAccountListOutput" />
    </Exec>
    <Exec Condition="$(AZURE_DEVOPS_EXT_PAT)=='' And $(AzAccountListOutput.Contains('az login'))" Command="az login" />
    <Message Importance="high"  text="Publishing universal package $(PackageName) in directory $(PackagePublishDir) with version $(PackageVersion)" />
    <Exec Command="az artifacts universal publish --organization $(AzOrganization) --project=$(AzProject) --scope project --feed $(AzArtifactFeed) --name $(PackageName) --version $(PackageVersion) --path $(PackagePublishDir)"/>
    <Message Importance="high"  text="Publishing storage package $(StoragePackageName) in directory $(StoragePackagePublishDir) with version $(PackageVersion)" />
    <Exec Command="az artifacts universal publish --organization $(AzOrganization) --project=$(AzProject) --scope project --feed $(AzArtifactFeed) --name $(StoragePackageName) --version $(PackageVersion) --path $(StoragePackagePublishDir)"/>
    <Message Importance="high"  text="Publishing storage cache-client package $(StorageCacheClientPackageName) in directory $(StorageCacheClientPackagePublishDir) with version $(PackageVersion)" />
    <Exec Command="az artifacts universal publish --organization $(AzOrganization) --project=$(AzProject) --scope project --feed $(AzArtifactFeed) --name $(StorageCacheClientPackageName) --version $(PackageVersion) --path $(StorageCacheClientPackagePublishDir)"/>

    <!-- Publish Python wheel package -->
    <Message Importance="high"  text="Publishing Python wheel package for dacs-client" />
    <PropertyGroup>
      <PythonPackageDir>$(MSBuildThisFileDirectory)..\src\subsystems\storage\py_dacs_cache_client</PythonPackageDir>
      <PyPIFeedUrl>internal-reference-removed)/$(AzProject)/_packaging/$(PyPIFeedName)/pypi/upload/</PyPIFeedUrl>
    </PropertyGroup>
    
    <!-- Check for python3 or python -->
    <Exec Command="which python3" IgnoreExitCode="true" ConsoleToMsBuild="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="Python3Path" />
      <Output TaskParameter="ExitCode" PropertyName="Python3ExitCode" />
    </Exec>
    <Exec Command="which python" IgnoreExitCode="true" ConsoleToMsBuild="true" IgnoreStandardErrorWarningFormat="true" Condition="$(Python3ExitCode)!='0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="PythonPath" />
      <Output TaskParameter="ExitCode" PropertyName="PythonExitCode" />
    </Exec>
    
    <!-- Set Python command -->
    <PropertyGroup>
      <PythonCmd Condition="$(Python3ExitCode)=='0'">python3</PythonCmd>
      <PythonCmd Condition="$(Python3ExitCode)!='0' And $(PythonExitCode)=='0'">python</PythonCmd>
    </PropertyGroup>
    
    <!-- Install Python if not found -->
    <Exec Command="sudo apt-get update &amp;&amp; sudo apt-get install -y python3 python3-pip" 
          IgnoreExitCode="true" 
          Condition="$(PythonCmd)==''">
      <Output TaskParameter="ExitCode" PropertyName="PythonInstallExitCode" />
    </Exec>
    <PropertyGroup Condition="$(PythonInstallExitCode)=='0'">
      <PythonCmd>python3</PythonCmd>
    </PropertyGroup>
    
    <!-- Update VERSION in setup.py with PackageRevision -->
    <PropertyGroup>
      <BaseVersion>1.2.0</BaseVersion>
      <PythonPackageVersion>$(BaseVersion).$(PackageRevision)</PythonPackageVersion>
    </PropertyGroup>
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="sed &quot;s/VERSION = '$(BaseVersion)'/VERSION = '$(PythonPackageVersion)'/&quot; setup.py &gt; setup.py.tmp &amp;&amp; mv setup.py.tmp setup.py" 
          IgnoreExitCode="false"
          Condition="$(PythonCmd)!=''"/>
    
    <!-- Clean and build Python package -->
    <RemoveDir Directories="$(PythonPackageDir)\dist;$(PythonPackageDir)\build" Condition="$(PythonCmd)!=''" />
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="$(PythonCmd) -m pip install --upgrade pip setuptools wheel" 
          IgnoreExitCode="true"
          Condition="$(PythonCmd)!=''"/>
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="$(PythonCmd) setup.py bdist_wheel" 
          IgnoreExitCode="true"
          Condition="$(PythonCmd)!=''">
      <Output TaskParameter="ExitCode" PropertyName="PythonBuildExitCode" />
    </Exec>
    
    <!-- Restore original setup.py -->
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="git checkout setup.py" 
          IgnoreExitCode="true"
          Condition="$(PythonCmd)!=''"/>
    
    <!-- Publish to PyPI feed -->
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="$(PythonCmd) -m pip install --upgrade twine" 
          IgnoreExitCode="true"
          Condition="$(PythonCmd)!='' And $(PythonBuildExitCode)=='0' And $(AZURE_DEVOPS_EXT_PAT)!=''"/>
    <Exec WorkingDirectory="$(PythonPackageDir)" 
          Command="$(PythonCmd) -m twine upload --repository-url $(PyPIFeedUrl) -u $(AzProject) -p $(AZURE_DEVOPS_EXT_PAT) dist/*.whl" 
          IgnoreExitCode="true" 
          Condition="$(PythonCmd)!='' And $(PythonBuildExitCode)=='0' And $(AZURE_DEVOPS_EXT_PAT)!=''">
      <Output TaskParameter="ExitCode" PropertyName="TwineExitCode" />
    </Exec>
    <Warning Condition="$(PythonCmd)==''" Text="Python not found and could not be installed. Skipping Python wheel package build." />
    <Warning Condition="$(PythonCmd)!='' And $(PythonBuildExitCode)!='0'" Text="Python wheel package build failed. Continuing with native package publishing." />
    <Warning Condition="$(TwineExitCode)!='0' And $(TwineExitCode)!=''" Text="Python wheel package upload failed with exit code $(TwineExitCode). Continuing with native package publishing." />

    <Exec Command="git tag -a 'v$(PackageVersion)' -m 'Published universal pacakge for $(PackageName) and $(StoragePackageName) with version $(PackageVersion)'"/>
    <Exec Condition="$(AZURE_DEVOPS_EXT_PAT)!=''" Command="git push origin 'v$(PackageVersion)'"/>
  </Target>

  <Target Name="AfterPublish" DependsOnTargets="PublishUniversalPackage" AfterTargets="Publish" />

</Project>
