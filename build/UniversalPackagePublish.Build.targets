<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)ResolveFrameworkReferences.targets" />

  <Target Name="PublishUniversalPackage">
    <Exec Condition="$(GIT_BRANCH)==''" Command="git rev-parse --symbolic-full-name --abbrev-ref HEAD" ConsoleToMsBuild="true" >
      <Output TaskParameter="ConsoleOutput" PropertyName="GIT_BRANCH" />
    </Exec>
    <Error Condition="'$(GIT_BRANCH)'=='main' And $(AZURE_DEVOPS_EXT_PAT)==''"
      Text="Build on main branch can only be executed in official pipeline." />
    <PropertyGroup>
      <PackageChannel Condition="'$(GIT_BRANCH)'=='main'">$(OfficialChannelName)</PackageChannel>
      <PackageChannel Condition="'$(PackageChannel)'==''">$(DevChannelName)</PackageChannel>
      <PackageName>$(PackageBaseName)-$(PackageChannel)</PackageName>
      <StoragePackageName>$(PackageBaseName)-storage-$(PackageChannel)</StoragePackageName>

      <CurrentDate>$([System.DateTime]::Now.ToString(Myddhhmm))</CurrentDate>
      <BranchHash Condition="'$(GIT_BRANCH)'=='main'">0</BranchHash>
      <BranchHash Condition="'$(BranchHash)'==''">$([System.Math]::Abs($(GIT_BRANCH.GetHashCode())).ToString().Substring(0, 5))</BranchHash>

      <PackageRevision Condition="'$(GIT_BRANCH)'=='main'">$(PACKAGE_REVISION)</PackageRevision>
      <PackageRevision Condition="'$(PackageRevision)'==''">0</PackageRevision>
      <PackageVersion>$(CurrentDate).$(BranchHash).$(PackageRevision)</PackageVersion>

      <PackagePublishDir>$(IntermediateOutputPath)$(ReferenceRuntimeIdentifier)\publish</PackagePublishDir>
      <StoragePackagePublishDir>$(IntermediateOutputPath)$(ReferenceRuntimeIdentifier)\publish-storage</StoragePackagePublishDir>
    </PropertyGroup>

    <Exec Command="az devops project list" IgnoreExitCode="true" ConsoleToMsBuild="true" IgnoreStandardErrorWarningFormat="true" >
      <Output TaskParameter="ConsoleOutput" PropertyName="AzAccountListOutput" />
    </Exec>
    <Exec Condition="$(AZURE_DEVOPS_EXT_PAT)=='' And $(AzAccountListOutput.Contains('az login'))" Command="az login" />
    <Message Importance="high"  text="Publishing universal package $(PackageName) in directory $(PackagePublishDir) with version $(PackageVersion)" />
    <Exec Command="az artifacts universal publish --organization $(AzOrganization) --project=$(AzProject) --scope project --feed $(AzArtifactFeed) --name $(PackageName) --version $(PackageVersion) --path $(PackagePublishDir)"/>
    <Message Importance="high"  text="Publishing storage package $(StoragePackageName) in directory $(StoragePackagePublishDir) with version $(PackageVersion)" />
    <Exec Command="az artifacts universal publish --organization $(AzOrganization) --project=$(AzProject) --scope project --feed $(AzArtifactFeed) --name $(StoragePackageName) --version $(PackageVersion) --path $(StoragePackagePublishDir)"/>
    <Exec Command="git tag -a 'v$(PackageVersion)' -m 'Published universal pacakge for $(PackageName) and $(StoragePackageName) with version $(PackageVersion)'"/>
    <Exec Condition="$(AZURE_DEVOPS_EXT_PAT)!=''" Command="git push origin 'v$(PackageVersion)'"/>
  </Target>

  <Target Name="AfterPublish" DependsOnTargets="PublishUniversalPackage" AfterTargets="Publish" />

</Project>
