<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="EmbedProjectReferences">

    <PropertyGroup>
        <PublishRuntimeIdentifier Condition=" '$(ReferenceRuntimeIdentifier)' != '' ">RuntimeIdentifier=$(ReferenceRuntimeIdentifier)</PublishRuntimeIdentifier>
        <AlwaysBuildProjectReferences>BuildingInsideVisualStudio=false</AlwaysBuildProjectReferences>
        <DoNotUpdateProjectAssetsJson>RestoreLockedMode=true</DoNotUpdateProjectAssetsJson>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Condition=" '%(ProjectReference.ReferenceRuntimeIdentifier)' != '' ">
        <PublishRuntimeIdentifier>RuntimeIdentifier=%(ProjectReference.ReferenceRuntimeIdentifier)</PublishRuntimeIdentifier>
      </ProjectReference>
      <ProjectReference Condition=" '%(ProjectReference.PublishRuntimeIdentifier)' == '' and '$(PublishRuntimeIdentier)' != '' ">
        <PublishRuntimeIdentifier>$(PublishRuntimeIdentifier)</PublishRuntimeIdentifier>
      </ProjectReference>
      <ProjectReference Condition=" '%(ProjectReference.ReferenceSelfContained)' != '' ">
        <SelfContained>%(ProjectReference.ReferenceSelfContained)</SelfContained>
      </ProjectReference>
      <ProjectReference Condition=" '%(ProjectReference.ReferenceSelfContained)' == '' ">
        <SelfContained>false</SelfContained>
      </ProjectReference>
    </ItemGroup>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="Publish"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=%(ProjectReference.SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); %(ProjectReference.PublishRuntimeIdentifier)"
        RemoveProperties="ContentSubFolder"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true"/>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="GetPublishPath"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=%(ProjectReference.SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); %(ProjectReference.PublishRuntimeIdentifier)"
        RemoveProperties="ContentSubFolder"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="ChildPublishItemsWithPublishPath"/>
    </MSBuild>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="GetTargetPath"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=%(ProjectReference.SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); %(ProjectReference.PublishRuntimeIdentifier)"
        RemoveProperties="ContentSubFolder"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="ChildPackageRootOnTargetPath"/>
    </MSBuild>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="GetContentItemsWithSubFolder"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); ContentSubFolder=%(ProjectReference.ContentSubFolder); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); %(ProjectReference.PublishRuntimeIdentifier)"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.ContentSubFolder)' != '' "
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="ProjectReferenceContentFiles"/>
    </MSBuild>

    <ItemGroup>
       <PackageRootFolderFiles Include="%(ProjectReference.RelativeDir)PackageRoot\**\*" Condition=" '%(ProjectReference.PackageRootFolder)' != '' ">
         <PackageRootFolder>%(ProjectReference.PackageRootFolder)</PackageRootFolder>
       </PackageRootFolderFiles>
       <PackageRootFolderFiles Include="%(ChildPackageRootOnTargetPath.RelativeDir)PackageRoot\**\*" Condition=" '%(ChildPackageRootOnTargetPath.PackageRootFolder)' != '' ">
         <PackageRootFolder>%(ChildPackageRootOnTargetPath.PackageRootFolder)</PackageRootFolder>
       </PackageRootFolderFiles>
       <CodePackageFiles Include="%(ChildPublishItemsWithPublishPath.Identity)**\*" Exclude="%(ChildPublishItemsWithPublishPath.Identity)**\PackageRoot\**\*" Condition="'%(ChildPublishItemsWithPublishPath.CodePackageFolder)' != ''">
         <CodePackageFolder>%(ChildPublishItemsWithPublishPath.CodePackageFolder)</CodePackageFolder>
       </CodePackageFiles>
    </ItemGroup>

    <Copy SourceFiles="@(CodePackageFiles)" DestinationFiles="@(CodePackageFiles -> '$(OutDir)%(CodePackageFolder)\%(RecursiveDir)%(Filename)%(Extension)')" Condition=" '@(CodePackageFiles)' != '' " SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(ProjectReferenceContentFiles)" DestinationFiles="@(ProjectReferenceContentFiles -> '$(OutDir)\%(TargetPath)')" Condition=" '@(ProjectReferenceContentFiles)' != '' " SkipUnchangedFiles="true"/>

  </Target>

</Project>