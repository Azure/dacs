<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <AssembleDockerScriptFileName>assemble_dockerfile.ps1</AssembleDockerScriptFileName>
    <AssembleDockerScriptFilePath>$(MSBuildThisFileDirectory)$(AssembleDockerScriptFileName)</AssembleDockerScriptFilePath>
    <ContainerImageName>$(MSBuildProjectName)</ContainerImageName>
    <DebugType>none</DebugType>
    <BuildBinaryContainerImagesPath>$(BuildBinaryRoot)/$(Configuration)/subsystems/containers/lnx/images</BuildBinaryContainerImagesPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="**" Exclude="*.dockerproj;*.sln;obj\**;.vs\**;*.md;**\Dockerfile*;**\*.testcases.json" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="**\Dockerfile.*" />

    <DockerTemplateFiles Include="**\Dockerfile.template" />
    <MetadataUpdateContent Include="**\*.testcases.json" />
  </ItemGroup>

</Project>
