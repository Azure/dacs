<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="RemoveChildCopyToOutputDirectoryItems"
          BeforeTargets="GetCopyToOutputDirectoryItems">

    <ItemGroup>
      <PackageReferenceProjectReference Include="@(_MSBuildProjectReferenceExistent)" >
        <UndefineProperties Condition=" '$(ReferenceRuntimeIdentifier)' != '' ">TargetFramework</UndefineProperties>
      </PackageReferenceProjectReference>

      <_MSBuildProjectReferenceExistent Remove="@(_MSBuildProjectReferenceExistent)" Condition=" '%(_MSBuildProjectReferenceExistent.IncludeSourceItems)' != 'true'  "/>
    </ItemGroup>

  </Target>

  <Target Name="EmbedProjectReferences">

    <PropertyGroup>
        <PublishRuntimeIdentifier Condition=" '$(ReferenceRuntimeIdentifier)' != '' ">RuntimeIdentifier=$(ReferenceRuntimeIdentifier)</PublishRuntimeIdentifier>
        <AlwaysBuildProjectReferences>BuildingInsideVisualStudio=false</AlwaysBuildProjectReferences>
        <DoNotUpdateProjectAssetsJson>RestoreLockedMode=true</DoNotUpdateProjectAssetsJson>
        <!-- We want to build framework-dependent packages, which are much smaller than self-contained -->
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="Publish"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=$(SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); $(PublishRuntimeIdentifier)"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true"/>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="GetPublishPath"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=$(SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); $(PublishRuntimeIdentifier)"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="ChildPublishItemsWithPublishPath"/>
    </MSBuild>

    <MSBuild
        Projects="@(ProjectReference)"
        Targets="GetTargetPath"
        BuildInParallel="$(BuildInParallel)"
        Properties="%(ProjectReference.SetConfiguration); %(ProjectReference.SetPlatform); SelfContained=$(SelfContained); $(AlwaysBuildProjectReferences); $(DoNotUpdateProjectAssetsJson); %(ProjectReference.SetTargetFramework); $(ProjectReference); $(PublishRuntimeIdentifier)"
        Condition="'@(ProjectReference)' != '' and '%(ProjectReference.CodePackageFolder)' != ''"
        ContinueOnError="$(ContinueOnError)"
        SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="ChildPackageRootOnTargetPath"/>
    </MSBuild>

    <ItemGroup>
       <PackageRootFolderFiles Include="%(ProjectReference.RelativeDir)PackageRoot\**\*" Condition=" '%(ProjectReference.PackageRootFolder)' != '' ">
         <PackageRootFolder>%(ProjectReference.PackageRootFolder)</PackageRootFolder>
       </PackageRootFolderFiles>
       <PackageRootFolderFiles Include="%(ChildPackageRootOnTargetPath.RelativeDir)PackageRoot\**\*" Condition=" '%(ChildPackageRootOnTargetPath.PackageRootFolder)' != '' ">
         <PackageRootFolder>%(ChildPackageRootOnTargetPath.PackageRootFolder)</PackageRootFolder>
       </PackageRootFolderFiles>
       <CodePackageFiles Include="%(ChildPublishItemsWithPublishPath.Identity)**\*" Exclude="%(ChildPublishItemsWithPublishPath.Identity)**\PackageRoot\**\*" Condition="'%(ChildPublishItemsWithPublishPath.CodePackageFolder)' != ''">
         <CodePackageFolder>%(ChildPublishItemsWithPublishPath.CodePackageFolder)</CodePackageFolder>
       </CodePackageFiles>
    </ItemGroup>

    <Copy SourceFiles="@(CodePackageFiles)" DestinationFiles="@(CodePackageFiles -> '$(OutDir)%(CodePackageFolder)\%(RecursiveDir)%(Filename)%(Extension)')" Condition=" '@(CodePackageFiles)' != '' " SkipUnchangedFiles="true"/>

  </Target>

  <Target Name="EmbedPackageRootReferences"
          Condition=" '@(PackageRootFolderFiles)' != '' "
          Inputs="@(PackageRootFolderFiles)"
          Outputs="@(PackageRootFolderFiles -> '$(OutDir)%(PackageRootFolder)\%(RecursiveDir)%(Filename)%(Extension)')" >

    <Copy SourceFiles="@(PackageRootFolderFiles)" DestinationFiles="@(PackageRootFolderFiles -> '$(OutDir)%(PackageRootFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>

    <ItemGroup>
      <MetadataUpdateContent Include="$(OutDir)%(ProjectReference.MetadataUpdateContent)"
                      Condition = " '%(ProjectReference.MetadataUpdateContent)' != ''" />
    </ItemGroup>

  </Target>

  <Target Name="PkgProjRemoveCopyLocal"
          BeforeTargets="_CopyFilesMarkedCopyLocal" >

    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>

  </Target>

</Project>