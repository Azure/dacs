<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <CMAKE_BINARY_DIR>$(OutputPath)</CMAKE_BINARY_DIR>
    <CMAKE_LIBRARY_OUTPUT_DIRECTORY>$(IntermediateOutputPath)/linux-x64/publish</CMAKE_LIBRARY_OUTPUT_DIRECTORY>
    <CMAKE_RUNTIME_OUTPUT_DIRECTORY>$(CMAKE_BINARY_DIR)</CMAKE_RUNTIME_OUTPUT_DIRECTORY>
    <CMAKE_CXX_STANDARD>17</CMAKE_CXX_STANDARD>
    <CMAKE_CXX_STANDARD_REQUIRED>TRUE</CMAKE_CXX_STANDARD_REQUIRED>
    <CMAKE_C_STANDARD>99</CMAKE_C_STANDARD>
    <CMAKE_C_STANDARD_REQUIRED>TRUE</CMAKE_C_STANDARD_REQUIRED>
    <CMAKE_EXTERNAL_PROJECT>$(MSBuildThisFileDirectory)cmake/external</CMAKE_EXTERNAL_PROJECT>
    <CMAKE_DEP_INSTALL_DIR>/dependency</CMAKE_DEP_INSTALL_DIR>
    <CMAKE_BUILD_CONFIGURATION>$(Configuration)</CMAKE_BUILD_CONFIGURATION>
    <CMAKE_DEVICE_PROXY_CUDA_VERSION>10.1.243</CMAKE_DEVICE_PROXY_CUDA_VERSION>
    <CMAKE_DEVICE_PROXY_NCCL_VERSION>2.4.8</CMAKE_DEVICE_PROXY_NCCL_VERSION>
    <CMAKE_REMOTE_PUBLISH_DIRECTORY>$(IntermediateOutputPath)/linux-x64/publish</CMAKE_REMOTE_PUBLISH_DIRECTORY>
    <CTEST_REMOTE_LIB_DIRECTORY>/usr/local/cuda-10.1/compat/</CTEST_REMOTE_LIB_DIRECTORY>
  </PropertyGroup>

  <ItemGroup>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_BINARY_DIR=$(CMAKE_BINARY_DIR)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_LIBRARY_OUTPUT_DIRECTORY=$(CMAKE_LIBRARY_OUTPUT_DIRECTORY)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_RUNTIME_OUTPUT_DIRECTORY=$(CMAKE_RUNTIME_OUTPUT_DIRECTORY)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_CXX_STANDARD=$(CMAKE_CXX_STANDARD)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_CXX_STANDARD_REQUIRED=$(CMAKE_CXX_STANDARD_REQUIRED)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_C_STANDARD=$(CMAKE_C_STANDARD)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_C_STANDARD_REQUIRED=$(CMAKE_C_STANDARD_REQUIRED)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_EXTERNAL_PROJECT=$(CMAKE_EXTERNAL_PROJECT)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_DEP_INSTALL_DIR=$(CMAKE_DEP_INSTALL_DIR)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_DEPENDENCY_ONLY=$(CMAKE_DEPENDENCY_ONLY)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_BUILD_CONFIGURATION=$(CMAKE_BUILD_CONFIGURATION)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_DEVICE_PROXY_CUDA_VERSION=$(CMAKE_DEVICE_PROXY_CUDA_VERSION)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_DEVICE_PROXY_NCCL_VERSION=$(CMAKE_DEVICE_PROXY_NCCL_VERSION)"/>
    <LinuxCMakeEnvironmentProperties Include="CMAKE_REMOTE_PUBLISH_DIRECTORY=$(CMAKE_REMOTE_PUBLISH_DIRECTORY)"/>
    <LinuxCMakeEnvironmentProperties Include="CTEST_REMOTE_LIB_DIRECTORY=$(CTEST_REMOTE_LIB_DIRECTORY)"/>
    <LinuxCMakeEnvironmentProperties Include="OBJ_DIR=$(IntermediateOutputPath)"/>
  </ItemGroup>

</Project>