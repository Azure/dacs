<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <EmbedProjectReferencesBuildDependsOnTargets>
      EmbedProjectReferences;
    </EmbedProjectReferencesBuildDependsOnTargets>
    <PackageDependsOnTargets Condition=" '$(GenerateNugetPackage)' == 'true' " >
      Pack;
    </PackageDependsOnTargets>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)EmbedProjectReference.targets" />
  <Import Project="$(MSBuildThisFileDirectory)UpdateMetadata\UpdateMetadataContent.targets" />

  <Target Name="EmbedProjectReferencesBuild"
    DependsOnTargets="$(EmbedProjectReferencesBuildDependsOnTargets)" 
    AfterTargets="Build" />

</Project>
