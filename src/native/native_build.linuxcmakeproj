<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup>
    <CMakePathToSource>$(RepositoryRootPath).</CMakePathToSource>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <_NativeBuild>src/native/</_NativeBuild>
    <_CudaBuild>build/SetupBuildDependencies/</_CudaBuild>
    <_NativeLib>src/subsystems/common/native_lib/</_NativeLib>
    <_DeviceProxy>src/subsystems/reliability/device_proxy/</_DeviceProxy>
    <_CriuDeduper>src/subsystems/reliability/criu_deduper/</_CriuDeduper>
    <_CallStackUtils>src/subsystems/reliability/callstack_utils/</_CallStackUtils>
    <_ProfilerUtils>src/subsystems/reliability/profiler_utils/</_ProfilerUtils>
    <_SysInterceptors>src/subsystems/reliability/sys_interceptors/</_SysInterceptors>
    <_LfsCkpt>src/subsystems/reliability/lfs_ckpt/</_LfsCkpt>
    <_AmdNcclIntercept>src/subsystems/reliability/amd_nccl_intercept/</_AmdNcclIntercept>
    <_NodeResourceManagerDeviceManagement>src/subsystems/hosting/node_resource_manager/DeviceManagement/</_NodeResourceManagerDeviceManagement>
    <_ReliabilityCommonNative>src/subsystems/reliability/common/native/</_ReliabilityCommonNative>
    <_StorageIntercept>src/subsystems/storage/storage_intercept/</_StorageIntercept>
    <_CacheServer>src/subsystems/storage/cache_server/</_CacheServer>
    <_StorageCommonNative>src/subsystems/storage/common/</_StorageCommonNative>
    <_DynamicPatches>src/subsystems/reliability/dynamic_patches/</_DynamicPatches>
    <_ABTest>src/subsystems/reliability/ab_test/</_ABTest>
    <_ABTestTests>src/subsystems/reliability/ab_test.tests/</_ABTestTests>

    <_SrcSyncDirs>$(RepositoryRootPath)/$(_NativeBuild)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_CudaBuild)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_NativeLib)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_CriuDeduper)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_CallStackUtils)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_ProfilerUtils)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_SysInterceptors)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_DeviceProxy)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_LfsCkpt)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_AmdNcclIntercept)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_NodeResourceManagerDeviceManagement)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_ReliabilityCommonNative)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_StorageIntercept)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_CacheServer)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_StorageCommonNative)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_DynamicPatches)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_ABTest)</_SrcSyncDirs>
    <_SrcSyncDirs>$(_SrcSyncDirs):$(RepositoryRootPath)/$(_ABTestTests)</_SrcSyncDirs>
  </PropertyGroup>

  <ItemGroup>
    <!--SRC_SYNC_DIRS has a list of source tree subfolders that must be copied from /repo to /tmp/repo in order to perform the build.
        It is much, much faster to build on Linux FS than on Windows.
    -->
    <LinuxCMakeEnvironmentProperties Include="SRC_SYNC_DIRS=$(_SrcSyncDirs)" />
    <NativeInputFiles Include="$(RepositoryRootPath)CMakeLists.txt" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_NativeBuild)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_NativeLib)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_DeviceProxy)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_CriuDeduper)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_CallStackUtils)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_ProfilerUtils)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_SysInterceptors)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_LfsCkpt)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_AmdNcclIntercept)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_NodeResourceManagerDeviceManagement)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_ReliabilityCommonNative)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_CacheServer)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_DynamicPatches)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_ABTest)**" />
    <NativeInputFiles Include="$(RepositoryRootPath)$(_ABTestTests)**" />
  </ItemGroup>
</Project>
