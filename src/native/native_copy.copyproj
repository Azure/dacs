<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.Build.NoTargets" >
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <!-- Set runtime identifier based on build architecture -->
    <RuntimeIdentifiers Condition="'$(BuildArchitecture)' == 'arm64'">linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepositorySrcRootPath)native/native_build.linuxcmakeproj" >
      <!-- Set reference runtime identifier based on build architecture -->
      <ReferenceRuntimeIdentifier Condition="'$(BuildArchitecture)' == 'arm64'">linux-arm64</ReferenceRuntimeIdentifier>
      <ReferenceRuntimeIdentifier Condition="'$(BuildArchitecture)' != 'arm64'">linux-x64</ReferenceRuntimeIdentifier>
      <CodePackageFolder>job/native/lib</CodePackageFolder>
    </ProjectReference>
  </ItemGroup>
</Project>
