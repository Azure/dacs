<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>

    <!-- Only handle ARM64 architecture specifically -->
    <ReferenceRuntimeIdentifier Condition="'$(BuildArchitecture)' == 'arm64'">linux-arm64</ReferenceRuntimeIdentifier>
    <ReferenceRuntimeIdentifier Condition="'$(ReferenceRuntimeIdentifier)' == ''">linux-x64</ReferenceRuntimeIdentifier>
    
    <!-- Only add architecture suffix for ARM64 -->
    <ContainerImageName Condition="'$(BuildArchitecture)' == 'arm64'">$(MSBuildProjectName)-$(BuildArchitecture)</ContainerImageName>
    <ContainerImageName Condition="'$(ContainerImageName)' == ''">$(MSBuildProjectName)</ContainerImageName>
    
    <!-- Use unified template for all architectures -->
    <DockerfileTemplate>Dockerfile.template</DockerfileTemplate>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include the appropriate Dockerfile template -->
    <DockerTemplateFiles Include="$(DockerfileTemplate)" />
  </ItemGroup>
</Project>
