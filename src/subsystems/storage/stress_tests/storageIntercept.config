storagePath /mnt/quiverfs
type blob
azBlobStorageAccountName storageinterceptionpr1
azBlobSASToken dummy
azBlobStorageEndpoint https://storageinterceptionpr1.blob.core.windows.net
azBlobContainerName dataset
maxConnsPerBlobClient 160
chunkDownloadMaxConcurrency 160
chunkDownloadParallelismEnabled true
enableLargePrefetch true
prefetchWindowSizeInMB 24
cacheEnable true
attributesCacheEnable true
attributesCacheUseLocalServer false
attributesCacheMaxEntries 10000000
cacheUseLocalFS false
cacheLocalFSCachePath /app/_cache
cacheLocalFSCacheStagingPath /app/_cacheTemp
cacheServerPort 9065
cacheEnableRemote true
cacheKeyExpirySeconds 3600
cacheServerList cacheserver-0.cacheserver.default.svc.cluster.local
cacheNumUploadThreadsPerProcess 4
cacheMaxUploadBufferSizePerProcessGB 200
cacheEnableSyncUpload true
cacheReuseServerConnections true
enableReadIOLogs true
logRefreshIntervalInSeconds 10
cacheAuthEnabled false
cacheAuthAccountName abc
cacheAuthAccountKey 123
cacheEncryptionEnabled false
cacheEncryptionKey abc123
cacheIBEnabled false
cacheServerDiscoveryEnabled false
ConfigNameCacheServerDiscoveryIntervalInSeconds 300
cacheServerDiscoveryEndpoint 127.0.0.1
