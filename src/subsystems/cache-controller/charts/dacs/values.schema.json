{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["manager"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "description": "Registry used for DACS images (empty disables the registry prefix)"
        }
      }
    },
    "manager": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of controller replicas. Leader election is enabled automatically when > 1."
        },
        "namespace": {
          "type": "string",
          "description": "Namespace for controller (empty = Release.Namespace)"
        },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "description": "Image tag (empty defaults to .Chart.AppVersion)"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "cacheServerImage": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "Cache server container image repository"
            },
            "tag": {
              "type": "string",
              "description": "Cache server image tag (defaults to .Chart.AppVersion)"
            }
          }
        },
        "affinity": {
          "type": "object",
          "description": "Pod scheduling affinity. Defaults to scheduling only on linux amd64/arm64 nodes, prefer system nodepool, and spread across nodes."
        },
        "nodeSelector": {
          "type": "object",
          "description": "Node selector for pod scheduling."
        },
        "tolerations": {
          "type": "array",
          "description": "Pod tolerations. Defaults to tolerating the CriticalAddonsOnly taint.",
          "items": {
            "type": "object"
          }
        },
        "priorityClassName": {
          "type": "string",
          "description": "PriorityClass for the controller pod. Empty string uses the chart-managed PriorityClass (<fullname>-priority); set a name to use an existing PriorityClass instead."
        }
      }
    },
    "rbacHelpers": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "Install convenience admin/editor roles for CRDs"
        }
      }
    },
    "crd": {
      "type": "object",
      "properties": {
        "keep": {
          "type": "boolean",
          "description": "Keep CRDs when uninstalling chart"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "forceDeleteCaches": {
          "type": "boolean",
          "description": "Delete all Cache CRs cluster-wide before uninstall, clearing finalizers on remaining terminating Caches after cleanup.timeoutSeconds."
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "Enable admission webhooks for Cache CR defaulting and validation"
        },
        "failurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"],
          "description": "Failure policy for webhook calls"
        }
      }
    }
  }
}
