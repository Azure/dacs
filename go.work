go 1.25.5

// Workspace decouples test/go.sum from cache-controller's transitive deps so
// Dependabot bumps in cache-controller don't break test/ builds.
// cache_server_scheduler is intentionally excluded: it pins older k8s.io/* and
// isn't imported by the other two modules.
use (
	./src/subsystems/cache-controller
	./test
)
