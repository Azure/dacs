# dacs - Build Artifacts and Generated Files

# Editor and IDE
.vscode/
.vs/
.idea/
*.swp
*~

# Build outputs
bin/
build/
obj/
out/
*.log
*.wrn
*.err

# CMake build cache
cmake-build-debug/
cmake-build-release/

# Compiler cache (ccache)
.ccache/

# Docker build context - copied binaries, not source
Docker/storage/

# Binary files
*.exe
*.dll
*.so
*.o
*.a
*.tar
*.rar
*.7z

# Temporary and cache files
*.tmp
*.cache
*.pyc
__pycache__/
node_modules/

# Python packages
*.whl
*.tar.gz
!torch*.whl
*.egg-info/
dist/
build/

# Local dependencies
.pipelines/deps/

# Test and data directories
data/
test_*/
dump*/
integtest/
blob*/
init-store/
test*/
runs/
logs/
.hypothesis/

# Protobuf autogenerated files
*.pb.cc
*.pb.h
