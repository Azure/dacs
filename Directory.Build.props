  <Import Project="$(MSBuildThisFileDirectory)build\LinuxCMakeProj.Build.props" Condition="'$(MSBuildProjectExtension)'=='.linuxcmakeproj'" />
  <Import Project="$(MSBuildThisFileDirectory)build\UniversalPackagePublish.Build.props" Condition="'$(MSBuildProjectExtension)'=='.upackpublishproj'" />
  <Import Project="$(MSBuildThisFileDirectory)build\Dockerproj.Build.props" Condition="'$(MSBuildProjectExtension)'=='.dockerproj'" />
